<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay.

  Adds an exported shim (`SmokeTestActivity`) so `adb shell am start` can drive real playback
  during the smoke test. The release manifest does not contain this activity, so the shipped app
  keeps PlayerActivity unexported.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".SmokeTestActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="com.gan.spatialplayer.SMOKE_PLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SmokeTrackProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="com.gan.spatialplayer.SMOKE_TRACKS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SmokeProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="com.gan.spatialplayer.SMOKE_PROBE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
