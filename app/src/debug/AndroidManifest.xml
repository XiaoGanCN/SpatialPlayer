<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay.

  Adds an exported shim (`SmokeTestActivity`) so `adb shell am start` can drive real playback
  during the smoke test. The release manifest does not contain this activity, so the shipped app
  keeps PlayerActivity unexported.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity android:name="org.spatialplayer.ScreenSpaceGlassProbeActivity" android:exported="true" />
        <activity android:name=".LiveGlassProbeActivity" android:exported="true" android:excludeFromRecents="true" />
        <activity android:name=".TopFadeProbeActivity" android:exported="true" />
        <activity
            android:name=".SmokeTestActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="org.spatialplayer.SMOKE_PLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SmokeTrackProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="org.spatialplayer.SMOKE_TRACKS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SmokeSpatialProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="org.spatialplayer.SMOKE_SPATIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SmokePowerampProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="org.spatialplayer.SMOKE_POWERAMP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SmokeProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="org.spatialplayer.SMOKE_PROBE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
            <activity
            android:name=".SmokeSpatialToggleProbeActivity"
            android:exported="true"
            android:theme="@style/Theme.SpatialPlayer">
            <intent-filter>
                <action android:name="org.spatialplayer.SMOKE_SPATIAL_TOGGLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


            <activity
            android:name=".SmokeAudioOutputProbeActivity"
            android:exported="true"
            android:theme="@style/Theme.SpatialPlayer">
            <intent-filter>
                <action android:name="org.spatialplayer.SMOKE_AUDIO_OUTPUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SmokeChaptersProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.SpatialPlayer">
            <intent-filter>
                <action android:name="org.spatialplayer.SMOKE_CHAPTERS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Fires the inspector-panel probe at the player that is already on screen, for
          `tools/verify-panels.sh`. Not an intent-filter: the suite starts it explicitly by name, and
          a filter would add an entry to the launcher's share targets for a diagnostic.
        -->
        <activity
            android:name=".PanelProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.SpatialPlayer" />

        <!--
          Asks the decoder itself what it can do with a file, one boundary at a time. Started by
          name with a `-d <content-uri>`; no intent filter, for the same reason as the probe above.
        -->
        <activity
            android:name=".DecodeProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.SpatialPlayer" />

        <activity
            android:name=".TrackProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.SpatialPlayer" />

        <!--
          Renders the launcher mark and the header icons at their real sizes into a PNG the host
          pulls and looks at, because a vector source says nothing about what 22 dp does to it.
        -->
        <activity
            android:name=".IconProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.SpatialPlayer" />

        <activity
            android:name=".GlassRenderProbeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.SpatialPlayer" />

        <activity android:name=".GlassOpticsProbeActivity" android:exported="true" android:excludeFromRecents="true" />
    </application>
</manifest>
