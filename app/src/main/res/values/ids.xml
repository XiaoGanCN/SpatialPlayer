<?xml version="1.0" encoding="utf-8"?>
<!--
  Ids for views the code builds rather than inflates.

  The inspector sheet is constructed in `InspectorSheet.buildDialog`, so it had no ids to query and
  no way to be introspected: `uiautomator dump` could see the tab labels but nothing that said which
  panel was actually rendered or whether it had any rows. A suite that has to assert on a panel needs
  those two handles, and this is cheaper than a probe activity that reimplements the sheet.
-->
<resources>
    <!-- The vertical list a panel's rows are added to. Empty it and the panel shows nothing. -->
    <item name="sheet_content" type="id" />

    <!-- The stand-in row a panel renders instead of rows when it has none. -->
    <item name="sheet_empty" type="id" />

    <!-- The scrollable strip of panel tabs. -->
    <item name="sheet_tab_strip" type="id" />

    <!-- The sheet's own panel, so a test can scope a matcher to this dialog's window. -->
    <item name="sheet_panel" type="id" />

    <!--
      A section heading ("Playback speed", "Spatial", ...).

      Tagged rather than identified by shape: a heading and an option row with a subtitle are both
      two-child LinearLayouts, so nothing about the tree tells them apart. A probe that had to guess
      counted a subtitle row as a heading and reported a populated panel as empty.
    -->
    <item name="sheet_section" type="id" />

    <!--
      Which glass role a view wears, set as `android:tag` in the layout.

      Tagged because a Drawable cannot be identified by its resource. `GlassInstaller` originally
      matched a view's background by loading the resource and comparing `constantState`, and that
      **never matches for a `RippleDrawable`**: every `getDrawable` call builds a new drawable with a
      fresh constant state, even for the same resource id. So every XML-declared glass background was
      left as the flat gradient it was supposed to replace - which is what "the UI looks unchanged"
      actually was. The player's own buttons only worked because `InspectorSheet` and
      `SettingsActivity` set their backgrounds in code, where the comparison does happen by identity.

      Measured on the main screen before the fix:
      `glass walk matched nothing: 9 painted view(s)`.
    -->
    <item name="glass_role_button" type="id" />
    <item name="glass_role_button_active" type="id" />
    <item name="glass_role_bar" type="id" />
    <item name="glass_role_panel" type="id" />
    <item name="control_owns_touch" type="id" />
    <item name="glass_role" type="id" />
    <item name="glass_role_sheet" type="id" />
    <item name="glass_role_panel_active" type="id" />
    <item name="sheet_resize" type="id" />
</resources>
