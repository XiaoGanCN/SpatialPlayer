<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="surface_view"
        app:resize_mode="fit"
        app:use_controller="false"
        app:shutter_background_color="@android:color/black" />
    <org.spatialplayer.ui.AmbientGlowView
        android:id="@+id/ambientGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <View
        android:id="@+id/gestureLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <TextView
        android:id="@+id/seekFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/bg_glass_panel"
        android:padding="20dp"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />
    <ImageButton
        android:id="@+id/centerPlayPause"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="invisible"
        android:background="@drawable/bg_glass_button"
        android:src="@drawable/ic_play"
        android:contentDescription="@string/play" />
    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/playerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_button"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/close" />
            <TextView
                android:id="@+id/mediaTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
            <ImageButton
                android:id="@+id/buttonInspect"
                android:layout_marginStart="6dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_button"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_inspect"
                android:contentDescription="@string/inspection" />
            <ImageButton
                android:id="@+id/buttonMetadata"
                android:layout_marginStart="6dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_button"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info"
                android:contentDescription="@string/metadata" />
            <View
                android:id="@+id/playerChipFade"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
        <org.spatialplayer.ui.LiquidGlassView
            android:id="@+id/controlGlass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:padding="14dp">
            <LinearLayout
                android:id="@+id/timelineRow"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/timeCurrent"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
                <org.spatialplayer.ui.SeekBarView
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="32dp"
                    android:minWidth="80dp" />
                <TextView
                    android:id="@+id/timeRemaining"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/transportRow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/buttonSpeed"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="1×"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:background="@drawable/bg_glass_button"
                    android:contentDescription="@string/speed" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <ImageButton
                    android:id="@+id/buttonRewind"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_glass_button"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_seek_backward"
                    android:contentDescription="@string/seek_back" />
                <ImageButton
                    android:id="@+id/buttonPlayPause"
                    android:layout_marginHorizontal="8dp"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_glass_button"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:contentDescription="@string/play" />
                <ImageButton
                    android:id="@+id/buttonForward"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_glass_button"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_seek_forward"
                    android:contentDescription="@string/seek_forward" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <ImageButton
                    android:id="@+id/buttonMore"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_glass_button"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_more"
                    android:contentDescription="@string/more" />
            </LinearLayout>
        </org.spatialplayer.ui.LiquidGlassView>
        <HorizontalScrollView
            android:id="@+id/playerChipScroll"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:visibility="visible"
            android:layout_gravity="top"
            android:layout_marginTop="68dp"
            android:layout_marginHorizontal="16dp"
            android:scrollbars="none">
            <org.spatialplayer.ui.ChipStrip
                android:id="@+id/playerChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/errorCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="128dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">
        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_playback"
            android:textColor="@color/bad" />
        <TextView
            android:id="@+id/errorText"
            style="@style/Text.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/buttonDismissError"
                style="@style/GlassButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close" />
            <TextView
                android:id="@+id/buttonCopyError"
                style="@style/GlassButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/copy_detail" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
