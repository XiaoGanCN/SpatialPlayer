<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <!--
      Thumbnail slot: a 16:9 frame that a decoded preview is drawn into, with the icon used as the
      placeholder for audio or when no frame can be produced.
    -->
    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="58dp"
        android:layout_height="34dp"
        android:alpha="0.92"
        android:background="@drawable/bg_thumb_frame"
        android:contentDescription="@null"
        android:padding="7dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_aspect" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/rowMeta"
            style="@style/Text.Row.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Artist and album, when the source provides them. Hidden otherwise. -->
        <TextView
            android:id="@+id/rowTags"
            style="@style/Text.Row.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
