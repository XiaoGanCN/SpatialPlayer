<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">
    <com.gan.spatialplayer.ui.AmbientGlowView
        android:id="@+id/ambientScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spatial Player"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/headerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/buttonSettings"
                android:layout_marginStart="6dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_button"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />
            <ImageButton
                android:id="@+id/buttonRefresh"
                android:layout_marginStart="6dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_button"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                android:contentDescription="@string/refresh" />
            <ImageButton
                android:id="@+id/buttonSpatialStatus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="@string/audio_settings" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp">
            <HorizontalScrollView
                android:id="@+id/chipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <com.gan.spatialplayer.ui.ChipStrip
                    android:id="@+id/chipStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </HorizontalScrollView>
            <View
                android:id="@+id/chipFade"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/buttonOpenFile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Open file"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:background="@drawable/bg_glass_button"
                android:layout_weight="1"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/buttonOpenFolder"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:padding="14dp"
                android:background="@drawable/bg_glass_button"
                android:src="@drawable/ic_folder"
                android:contentDescription="Open folder" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/actionBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="20dp"
            android:padding="0dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:id="@+id/buttonLibrary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/bg_glass_button"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Videos"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
                <ImageView
                    android:id="@+id/libraryChevron"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/buttonPoweramp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/bg_glass_button"
                android:layout_marginEnd="0dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Music"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
                <ImageView
                    android:id="@+id/powerampChevron"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/scanProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:indeterminate="true"
            android:layout_marginTop="12dp" />
        <FrameLayout
            android:id="@+id/libraryBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fileList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp"
                android:paddingBottom="20dp"
                android:clipToPadding="false" />
            <TextView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="32dp"
                android:text="Open a file or choose a folder to get started."
                android:textSize="17sp"
                android:textColor="@color/text_secondary" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
