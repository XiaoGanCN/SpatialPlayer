<?xml version="1.0" encoding="utf-8"?>
<!--
  Indicator chip strip.

  Facts about the device and the current stream - HDR format, spatial audio state, decoder in use -
  are one-word statuses, not sentences. Rendering them as small pills keeps them scannable at a
  glance and stops them competing with the file names for attention.
-->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chipScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp"
    android:clipToPadding="false"
    android:scrollbars="none"
    android:fillViewport="false">

    <LinearLayout
        android:id="@+id/chipRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
</HorizontalScrollView>
