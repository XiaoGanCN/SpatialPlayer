<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded frame behind a list thumbnail.

  The thumbnail is drawn as a child, so this shape sits behind it and the corner clip comes from
  the shape rather than from `clipToOutline`, which is cheaper and works on every row.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="7dp" />
    <solid android:color="@color/surface_sunken" />
    <stroke
        android:width="1dp"
        android:color="@color/divider" />
</shape>
