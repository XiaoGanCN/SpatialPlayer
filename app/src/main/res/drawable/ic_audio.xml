<?xml version="1.0" encoding="utf-8"?>
<!--
  Audio, as beamed eighth notes.

  This replaced a speaker-with-sound-waves glyph. A speaker is the symbol for *output*, not for
  music: it read as "this file has no picture" rather than as "this is a song", and it was the same
  shape as the volume controls elsewhere in the app. It is also a square glyph, so an audio row
  without cover art keeps the same 1:1 bound as one with it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
      The whole glyph sits inside x 4.5..19.5 and y 3.5..20.4, so its box is centred on the 24x24
      viewport rather than hanging off to the right of it - the first draft spanned x 7..22, which
      read as an icon that had not been centred at all.
    -->

    <!-- Beam across the top. -->
    <path
        android:fillColor="#FFF2F4F7"
        android:pathData="M8.1,3.5 L19.5,5.9 L19.5,8.1 L8.1,5.7 Z" />

    <!-- Left stem and head. -->
    <path
        android:fillColor="#FFF2F4F7"
        android:pathData="M8.1,5.1 L10.5,5.6 L10.5,18.1 L8.1,18.1 Z" />
    <path
        android:fillColor="#FFF2F4F7"
        android:pathData="M4.5,18.1 a3.0,2.3 0 1,0 6.0,0 a3.0,2.3 0 1,0 -6.0,0 Z" />

    <!-- Right stem and head, set higher to match the beam's slope. -->
    <path
        android:fillColor="#FFF2F4F7"
        android:pathData="M17.1,7.5 L19.5,8.0 L19.5,16.1 L17.1,16.1 Z" />
    <path
        android:fillColor="#FFF2F4F7"
        android:pathData="M13.5,16.1 a3.0,2.3 0 1,0 6.0,0 a3.0,2.3 0 1,0 -6.0,0 Z" />
</vector>
