<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass surface: soft translucent fill, hairline top highlight, wide corner radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_tint" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke_soft" />
</shape>
