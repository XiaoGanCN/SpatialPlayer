<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#668AB4F8"
                android:centerColor="#4D8AB4F8"
                android:endColor="#338AB4F8" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#B38AB4F8" />
        </shape>
    </item>
</ripple>
