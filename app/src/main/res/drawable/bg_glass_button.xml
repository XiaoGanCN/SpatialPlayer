<?xml version="1.0" encoding="utf-8"?>
<!--
  Glass button: a specular gradient fill rather than a flat tint, so the control reads as a raised
  surface catching light from above, plus a hairline rim.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#3DFFFFFF"
                android:centerColor="#1FFFFFFF"
                android:endColor="#14FFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</ripple>
